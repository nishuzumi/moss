{
  "name": "@themoss/agent",
  "version": "0.0.0",
  "description": "Moss agent-side intent alignment helpers for the discover → load → action → simulate flow",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
